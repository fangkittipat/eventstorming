{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EventStorm Markdown Preview",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/samples/order-placed.storm"
      ],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js"],
      "preLaunchTask": "npm: extension:build"
    }
  ]
}
