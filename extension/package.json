{
  "name": "eventstorm",
  "displayName": "EventStorm",
  "description": "Edit .storm files like any other source file. Preview the paper-note board (pan, zoom, wrap). Also renders ```eventstorm fences in Markdown preview.",
  "version": "0.1.11",
  "extensionKind": ["ui", "workspace"],
  "publisher": "fangkittipat",
  "author": "fangkittipat",
  "license": "MIT",
  "pricing": "Free",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#fff8e7",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fangkittipat/eventstorming.git"
  },
  "homepage": "https://github.com/fangkittipat/eventstorming",
  "bugs": {
    "url": "https://github.com/fangkittipat/eventstorming/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Visualization"],
  "keywords": [
    "eventstorming",
    "event-storming",
    "ddd",
    "domain-driven-design",
    "markdown",
    "storm"
  ],
  "scripts": {
    "vscode:prepublish": "npm run --prefix .. extension:build"
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.storm",
    "onLanguage:markdown",
    "onLanguage:eventstorm",
    "onCommand:eventstorm.preview",
    "onCommand:eventstorm.showSource",
    "onCommand:eventstorm.previewBoard",
    "onCommand:eventstorm.exportSvg",
    "onCommand:eventstorm.exportPng",
    "onCustomEditor:eventstorm.previewEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": ["./preview.css"],
    "customEditors": [
      {
        "viewType": "eventstorm.previewEditor",
        "displayName": "Preview",
        "selector": [{ "filenamePattern": "*.storm" }],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "eventstorm.preview",
        "title": "Preview",
        "shortTitle": "Preview",
        "category": "EventStorm",
        "icon": "$(open-preview)"
      },
      {
        "command": "eventstorm.showSource",
        "title": "Storm",
        "shortTitle": "Storm",
        "category": "EventStorm",
        "icon": "$(go-to-file)"
      },
      {
        "command": "eventstorm.previewBoard",
        "title": "Open Preview to the Side",
        "category": "EventStorm",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "eventstorm.exportSvg",
        "title": "Export SVG",
        "category": "EventStorm",
        "icon": "$(export)"
      },
      {
        "command": "eventstorm.exportPng",
        "title": "Export PNG",
        "category": "EventStorm",
        "icon": "$(file-media)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "eventstorm.preview",
          "when": "resourceLangId == eventstorm || resourceExtname == .storm || originalResourceLangId == eventstorm || originalResourceExtname == .storm",
          "alt": "eventstorm.previewBoard",
          "group": "navigation@1"
        },
        {
          "command": "eventstorm.showSource",
          "when": "resourceLangId == eventstorm || resourceExtname == .storm || originalResourceLangId == eventstorm || originalResourceExtname == .storm || activeCustomEditorId == 'eventstorm.previewEditor'",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "eventstorm.preview",
          "when": "resourceExtname == .md || resourceExtname == .storm || editorLangId == markdown || editorLangId == eventstorm || activeCustomEditorId == 'eventstorm.previewEditor'"
        },
        {
          "command": "eventstorm.showSource",
          "when": "resourceExtname == .storm || eventstormPreviewActive || activeCustomEditorId == 'eventstorm.previewEditor'"
        },
        {
          "command": "eventstorm.previewBoard",
          "when": "resourceExtname == .md || resourceExtname == .storm || editorLangId == markdown || editorLangId == eventstorm || activeCustomEditorId == 'eventstorm.previewEditor'"
        },
        {
          "command": "eventstorm.exportSvg",
          "when": "resourceExtname == .md || resourceExtname == .storm || editorLangId == markdown || editorLangId == eventstorm"
        },
        {
          "command": "eventstorm.exportPng",
          "when": "resourceExtname == .md || resourceExtname == .storm || editorLangId == markdown || editorLangId == eventstorm"
        }
      ],
      "editor/context": [
        {
          "command": "eventstorm.preview",
          "when": "resourceExtname == .storm || editorLangId == eventstorm",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "eventstorm.preview",
          "when": "resourceExtname == .storm",
          "group": "navigation"
        },
        {
          "command": "eventstorm.exportSvg",
          "when": "resourceExtname == .storm || resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "eventstorm.exportPng",
          "when": "resourceExtname == .storm || resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "eventstorm",
        "aliases": ["EventStorm", "storm"],
        "extensions": [".storm"]
      }
    ],
    "grammars": [
      {
        "language": "eventstorm",
        "scopeName": "source.eventstorm",
        "path": "./syntaxes/eventstorm.tmLanguage.json"
      }
    ]
  }
}
